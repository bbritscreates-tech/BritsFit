rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Top-level User document
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId)
        && incoming().id == userId
        && incoming().email is string
        && incoming().email.size() <= 256;
      allow update: if isOwner(userId)
        && incoming().id == existing().id;
      allow delete: if isOwner(userId);

      // Family member profiles subcollection
      match /familyProfiles/{profileId} {
        allow read, write: if isOwner(userId);
      }

      // Workouts subcollection
      match /workouts/{workoutId} {
        allow read, write: if isOwner(userId);
      }

      // Cardio subcollection
      match /cardio/{cardioId} {
        allow read, write: if isOwner(userId);
      }

      // Body measurements subcollection
      match /measurements/{measurementId} {
        allow read, write: if isOwner(userId);
      }

      // Daily habits subcollection
      match /habits/{habitId} {
        allow read, write: if isOwner(userId);
      }

      // Goals subcollection
      match /goals/{goalId} {
        allow read, write: if isOwner(userId);
      }

      // Custom exercises subcollection
      match /exercises/{exerciseId} {
        allow read, write: if isOwner(userId);
      }

      // Workout templates subcollection
      match /templates/{templateId} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
